<UserControl x:Class="InvoiceManager.App.Views.FeaturePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="40" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="64" Height="64" Background="#EAF1FF" CornerRadius="32">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="#2D6CDF" Text="•" />
            </Border>
            <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="#172033" Text="{Binding Title}" />
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="#6E7B91" Text="{Binding Description}" />
        </StackPanel>
    </Border>
</UserControl>
