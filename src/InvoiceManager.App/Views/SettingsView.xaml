<UserControl x:Class="InvoiceManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="BorderBrush" Value="#CFD6E2" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="#2F7D4A" Text="{Binding StatusMessage}" />
            <TextBlock Grid.Column="1" Foreground="#C43D3D" Text="{Binding ErrorMessage}" />
        </Grid>
        <Border Grid.Row="2" MaxWidth="900" Padding="28" HorizontalAlignment="Left"
                Background="White" BorderBrush="#E1E6EF" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Company settings" />
                    <TextBlock Margin="0,5,0,18" Foreground="#657089" Text="These details are copied into each new document snapshot." />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Company name *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding CompanyName}" />
                            <TextBlock Text="Street *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding Street}" />
                            <TextBlock Text="Postal code *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding PostalCode}" />
                            <TextBlock Text="City *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding City}" />
                            <TextBlock Text="Country *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding Country}" />
                            <TextBlock Text="VAT number" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding VatNumber}" />
                            <TextBlock Text="Chamber of commerce number" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding ChamberOfCommerceNumber}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IBAN" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding Iban}" />
                            <TextBlock Text="Email" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding Email}" />
                            <TextBlock Text="Phone" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding Phone}" />
                            <TextBlock Text="Default VAT (%) *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding DefaultVatRatePercentText}" />
                            <TextBlock Text="Default payment term (days) *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding DefaultPaymentTermDaysText}" />
                            <TextBlock Text="Currency *" /><TextBox Style="{StaticResource FieldStyle}" Text="{Binding Currency}" />
                            <TextBlock Text="Company logo" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Height="34" Padding="8,5" IsReadOnly="True" Text="{Binding LogoPath}" AutomationProperties.Name="Selected company logo path" />
                                <Button Grid.Column="1" Width="72" Margin="6,0" Command="{Binding BrowseLogoCommand}" Content="Browse" AutomationProperties.Name="Choose company logo" />
                                <Button Grid.Column="2" Width="62" Command="{Binding ClearLogoCommand}" Content="Clear" AutomationProperties.Name="Clear company logo" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Button Width="150" Height="38" HorizontalAlignment="Left" Background="White" BorderBrush="#CFD6E2"
                            Command="{Binding LoadDemoDataCommand}" Content="Load demo data" AutomationProperties.HelpText="Available only for an empty database" />
                    <Button Width="140" Height="38" HorizontalAlignment="Right"
                            Background="#2D6CDF" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                            Command="{Binding SaveCommand}" Content="Save settings" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
