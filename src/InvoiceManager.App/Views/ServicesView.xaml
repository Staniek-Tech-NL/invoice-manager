<UserControl x:Class="InvoiceManager.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#2D6CDF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#27344A" />
            <Setter Property="BorderBrush" Value="#CFD6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="BorderBrush" Value="#CFD6E2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="36" Padding="10,6" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search services" />
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SearchCommand}" Content="Search" />
            <CheckBox Grid.Column="2" Margin="16,0" VerticalAlignment="Center" IsChecked="{Binding IncludeInactive}" Content="Include inactive" />
            <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EditSelectedCommand}" Content="Edit" />
            <Button Grid.Column="5" Margin="8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeactivateSelectedCommand}" Content="Deactivate" />
            <Button Grid.Column="6" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCreateEditorCommand}" Content="+ Add service" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="#2F7D4A" Text="{Binding StatusMessage}" />
            <TextBlock Grid.Column="1" Foreground="#C43D3D" Text="{Binding ErrorMessage}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E1E6EF" BorderThickness="1" CornerRadius="10">
                <Grid>
                <DataGrid x:Name="ServicesGrid" ItemsSource="{Binding ProductServices}"
                          SelectedItem="{Binding SelectedProductService}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}" />
                        <DataGridTextColumn Width="*" Header="Unit" Binding="{Binding Unit}" />
                        <DataGridTextColumn Width="*" Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" />
                        <DataGridTextColumn Width="*" Header="VAT" Binding="{Binding VatRate, StringFormat={}{0:P0}}" />
                        <DataGridCheckBoxColumn Width="Auto" Header="Active" Binding="{Binding IsActive}" />
                    </DataGrid.Columns>
                </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E7B91" Text="No services yet. Add a reusable service to build documents faster." IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ServicesGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Width="380"
                    Margin="20,0,0,0"
                    Padding="22"
                    Background="White"
                    BorderBrush="#E1E6EF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#172033" Text="{Binding EditorTitle}" />

                    <ScrollViewer Grid.Row="1" Margin="0,18,0,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Name *" />
                            <TextBox Style="{StaticResource EditorTextBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Description" />
                            <TextBox Height="88" Margin="0,4,0,10" Padding="8,5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Unit *" />
                            <ComboBox Height="34" Margin="0,4,0,10" IsEditable="True" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="hour" />
                                <ComboBoxItem Content="day" />
                                <ComboBoxItem Content="item" />
                                <ComboBoxItem Content="service" />
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Unit price (€) *" />
                                    <TextBox Style="{StaticResource EditorTextBoxStyle}" Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VAT (%) *" />
                                    <TextBox Style="{StaticResource EditorTextBoxStyle}" Text="{Binding VatRatePercentText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelEditCommand}" Content="Cancel" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" Content="Save" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
